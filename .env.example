# =============================================================================
# Variáveis de build do front-end (Vite).
# Copie para .env.local e preencha. NÃO comite .env.local.
# Em produção, estes valores vêm dos GitHub Actions Secrets.
# =============================================================================

# URL do projeto Supabase (ex.: https://svbcwxrgizyihhyxqtmj.supabase.co)
VITE_SUPABASE_URL=

# Chave "anon" (pública) do Supabase. É segura no bundle: o acesso é restringido
# por RLS. NUNCA use aqui a service_role key nem a senha do banco.
VITE_SUPABASE_ANON_KEY=

# URL pública da aplicação, sem barra final
# (ex.: https://pesquisadoutoradounb-wq.github.io/doutorapatricia)
VITE_APP_BASE_URL=http://localhost:5173

# Caminho base do site (Vite `base`). Em produção: /doutorapatricia/
# Em desenvolvimento local pode deixar em branco (assume "/").
VITE_APP_BASE_PATH=/doutorapatricia/

# Modo do estudo exibido na interface: "piloto" ou "producao".
# Apenas rótulo/ível de UI — o modo real de cada participante vem do convite.
VITE_STUDY_MODE=piloto
